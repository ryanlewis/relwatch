{
  "name": "relwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Release tracker — polls upstream projects, LLM-triages each release at ingest, serves a dashboard and a daily email digest",
  "scripts": {
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test",
    "build": "bun build --compile --outfile relwatch src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "ai": "^7.0.0",
    "croner": "^10.0.0",
    "fast-xml-parser": "^5.10.1",
    "p-limit": "^7.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.0"
  }
}
